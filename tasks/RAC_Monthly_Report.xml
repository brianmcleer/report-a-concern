<?xml version="1.0" encoding="UTF-8"?>
<!--
  RAC_Monthly_Report
  Windows Task Scheduler import file for the Report a Concern (RAC) system.

  Before importing, edit:
    - Principal/UserId       : the service account that runs the job
    - Actions/Exec/Command   : path to python.exe in the cloned ArcGIS Pro env
    - Actions/Exec/Arguments : path to the script
    - Actions/Exec/WorkingDirectory

  WHY a cloned ArcGIS Pro env: the base arcgispro-py3 env fails with
  0x800700C1 (not a valid Win32 application) when launched from Task
  Scheduler on Windows Server 2025. Clone it in ArcGIS Pro (Package Manager)
  (clone arcgispro-py3 to arcgispro-py3-rac) and point Command at the clone.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>GIS</Author>
    <Description>Report a Concern: emails the all-department monthly report. Runs on the 1st of every month at 09:00.</Description>
    <URI>\RAC\RAC_Monthly_Report</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-01-01T09:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByMonth>
        <DaysOfMonth>
          <Day>1</Day>
        </DaysOfMonth>
        <Months>
          <January />
          <February />
          <March />
          <April />
          <May />
          <June />
          <July />
          <August />
          <September />
          <October />
          <November />
          <December />
        </Months>
      </ScheduleByMonth>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>DOMAIN\svc_gis</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\envs\arcgispro-py3-rac\python.exe</Command>
      <Arguments>D:\RAC\scripts\rac_all_dept_report.py</Arguments>
      <WorkingDirectory>D:\RAC\scripts</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
